+# ---------------------------------------------------------------------------
+# Display-width helpers
+# ---------------------------------------------------------------------------
+# Box-drawing characters (U+2500-U+257F) have East Asian Width "Ambiguous" but
+# are universally rendered as 1 cell in all terminals and editors.  Other
+# ambiguous-width characters (geometric shapes like ◀ ▼ ▲, U+25A0-U+25FF) are
+# rendered as **2 cells** in many editors (VS Code, Cursor, CJK terminals).
+# This mismatch causes visual misalignment that is invisible at the character-
+# index level.  The helpers below let the validator work in *display columns*
+# so it catches these issues.
+# ---------------------------------------------------------------------------
+
+def char_display_width(ch: str) -> int:
+    """Return display width of a single character in terminal cells.
+
+    Box-drawing characters are always 1-wide.  Full-width ('F'/'W') and
+    ambiguous-width ('A') characters are treated as 2-wide, which matches the
+    common behavior in VS Code, Cursor, and most modern terminal emulators.
+    """
+    if ch in ALL_BOX_CHARS:
+        return 1
+    eaw = unicodedata.east_asian_width(ch)
+    if eaw in ('F', 'W'):
+        return 2
+    if eaw == 'A':
+        return 2  # conservative: matches VS Code / Cursor default
+    return 1
+
+
+def char_at_display_col(line: str, target_dcol: int) -> str | None:
+    """Return the character whose display column equals *target_dcol*.
+
+    Returns ``None`` when *target_dcol* falls beyond the end of the line or
+    inside a wide character (i.e. the second cell of a 2-wide glyph).
+    """
+    dcol = 0
+    for ch in line:
+        if dcol == target_dcol:
+            return ch
+        w = char_display_width(ch)
+        if dcol + w > target_dcol:
+            return None  # target falls inside a wide character
+        dcol += w
+    return None  # beyond end of line
+
+
+def get_char_at_display_col(lines: list[str], row: int, target_dcol: int) -> str | None:
+    """Get the character at a display column on a given row, with bounds check."""
+    if row < 0 or row >= len(lines):
+        return None
+    return char_at_display_col(lines[row], target_dcol)
+
